# Copy this file to "keystore.properties" in the same folder (android-app/) on your Windows PC.
# NEVER commit keystore.properties or your .keystore/.jks file to git or upload them.
# Use forward slashes (/) or escaped backslashes (\\) for Windows paths.

storeFile=C:/coffeenadu-keys/coffeenadu-admin-release.keystore
storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
keyAlias=coffeenadu-admin
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
