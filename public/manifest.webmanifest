{
  "id": "/admin",
  "name": "CoffeeNadu Admin",
  "short_name": "CoffeeNadu",
  "description": "CoffeeNadu News Admin 2.0 — Editorial publishing, media branding, analytics, notifications, and system administration for CoffeeNadu News.",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#0B192C",
  "background_color": "#0B192C",
  "categories": ["news", "productivity", "business"],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard Overview",
      "short_name": "Dashboard",
      "description": "Open CoffeeNadu Admin 2.0 dashboard overview",
      "url": "/admin?section=dashboard",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Add New Article",
      "short_name": "Add News",
      "description": "Create and publish a new Kannada news article",
      "url": "/admin?section=add-article",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "News Management",
      "short_name": "News",
      "description": "Manage published articles, drafts, and lead stories",
      "url": "/admin?section=news",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Notification Centre",
      "short_name": "Alerts",
      "description": "View publishing, backup, and security notifications",
      "url": "/admin?section=notifications",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
